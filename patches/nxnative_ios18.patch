+#!/bin/bash
+# No game assets: syntax/type/availability check of the modified graphics
+# backend against the real iPhoneOS SDK. This does not link or run an app.
+set -euo pipefail
+DM=$(cd "$(dirname "$0")/../.." && pwd)
+[ "$(uname -s)" = Darwin ] || { echo "Requires macOS with Xcode (Apple SDK checks were not run)." >&2; exit 2; }
+: "${GAME:?Set GAME to an existing profile ID; no game files are needed}"
+[[ "$GAME" =~ ^[0-9A-Fa-f]{16}$ ]] || { echo "GAME must be a 16-digit profile ID" >&2; exit 2; }
+[ -f "$DM/games/$GAME/game.tsv" ] || { echo "Unknown profile: $GAME" >&2; exit 2; }
+command -v xcrun > /dev/null
+CHECK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/nxnative-ios18-check.XXXXXX")
+trap 'rm -rf "$CHECK_DIR"' EXIT
+python3 "$DM/games/game.py" header "$GAME" "$CHECK_DIR/game_profile.h"
+echo "iPhoneOS SDK: $(xcrun --sdk iphoneos --show-sdk-version); profile: $GAME"
+for source in "$DM/gfx/nvn/nvn_mtl.m" "$DM/gfx/tex/nvn_deswizzle_gpu.m"; do
+  xcrun --sdk iphoneos clang -arch arm64 -mcpu=apple-a14 \
+    -miphoneos-version-min=18.0 -std=gnu11 -fobjc-arc -fsyntax-only \
+    -Werror=unguarded-availability -Werror=unguarded-availability-new \
+    -Werror=implicit-function-declaration -DDM_NVN_M3=1 \
+    -I"$CHECK_DIR" -I"$DM/games/$GAME" -I"$DM/gfx/nvn/include" "$source"
+done
+echo "Apple SDK graphics checks passed. Linking, installation and GPU execution still need validation."
