diff --git a/dm/gfx/nvn/nvn_m3_ranges.h b/dm/gfx/nvn/nvn_m3_ranges.h
new file mode 100644
index 0000000..973aba8
--- /dev/null
+++ b/dm/gfx/nvn/nvn_m3_ranges.h
@@ -0,0 +1,58 @@
+#pragma once
+// Non-owning GPU-address lookup for the legacy Metal encoder. Callers hold a
+// lock and retain a returned Objective-C object before releasing that lock.
+#include <stdint.h>
+#include <stddef.h>
+#include <stdlib.h>
+
+typedef struct { uint64_t base, size; uintptr_t object; } nvn_m3_range;
+typedef struct { nvn_m3_range *v; size_t n, capacity, last; } nvn_m3_ranges;
+
+static inline int nvn_m3_ranges_add(nvn_m3_ranges *t, uintptr_t object,
+                                    uint64_t base, uint64_t size) {
+    if (!object || !base || !size || size - 1 > UINT64_MAX - base) return 0;
+    for (size_t i = 0; i < t->n; i++) if (t->v[i].object == object) {
+        t->v[i] = (nvn_m3_range){base, size, object};
+        return 1;
+    }
+    if (t->n == t->capacity) {
+        size_t cap = t->capacity ? t->capacity * 2 : 64;
+        if (cap < t->capacity || cap > SIZE_MAX / sizeof *t->v) return 0;
+        nvn_m3_range *v = realloc(t->v, cap * sizeof *v);
+        if (!v) return 0;
+        t->v = v; t->capacity = cap;
+    }
+    t->v[t->n++] = (nvn_m3_range){base, size, object};
+    return 1;
+}
+
+static inline void nvn_m3_ranges_remove(nvn_m3_ranges *t, uintptr_t object) {
+    for (size_t i = 0; i < t->n; i++) if (t->v[i].object == object) {
+        t->v[i] = t->v[--t->n]; t->last = 0;
+        return;
+    }
+}
+
+static inline int nvn_m3_range_contains(const nvn_m3_range *r,
+                                        uint64_t address, uint64_t size) {
+    return size && address >= r->base && address - r->base < r->size &&
+           size <= r->size - (address - r->base);
+}
+
+static inline uintptr_t nvn_m3_ranges_find(nvn_m3_ranges *t, uint64_t address,
+                                          uint64_t size, uint64_t *offset) {
+    *offset = 0;
+    if (!address || !size || !t->n) return 0;
+    size_t i = t->last;
+    if (i >= t->n || !nvn_m3_range_contains(&t->v[i], address, size)) {
+        for (i = 0; i < t->n; i++)
+            if (nvn_m3_range_contains(&t->v[i], address, size)) break;
+        if (i == t->n) return 0;
+    }
+    t->last = i; *offset = address - t->v[i].base;
+    return t->v[i].object;
+}
+
+static inline void nvn_m3_ranges_destroy(nvn_m3_ranges *t) {
+    free(t->v); *t = (nvn_m3_ranges){0};
+}
diff --git a/dm/gfx/tests/t_m3_ranges.c b/dm/gfx/tests/t_m3_ranges.c
new file mode 100644
index 0000000..df82147
--- /dev/null
+++ b/dm/gfx/tests/t_m3_ranges.c
@@ -0,0 +1,65 @@
+#include "../nvn/nvn_m3_ranges.h"
+#include <assert.h>
+#include <stdio.h>
+
+static uint32_t seed = 0x41a16u;
+static uint32_t random32(void) { seed ^= seed << 13; seed ^= seed >> 17; seed ^= seed << 5; return seed; }
+
+int main(void) {
+    nvn_m3_ranges t = {0}; uint64_t off;
+    assert(!nvn_m3_ranges_find(&t, 1, 1, &off) && off == 0);
+    assert(!nvn_m3_ranges_add(&t, 0, 0x1000, 16));
+    assert(!nvn_m3_ranges_add(&t, 1, 0, 16));
+    assert(!nvn_m3_ranges_add(&t, 1, 0x1000, 0));
+    assert(!nvn_m3_ranges_add(&t, 1, UINT64_MAX - 3, 5));
+    assert(nvn_m3_ranges_add(&t, 1, UINT64_MAX - 3, 4));
+    assert(nvn_m3_ranges_find(&t, UINT64_MAX, 1, &off) == 1 && off == 3);
+    assert(!nvn_m3_ranges_find(&t, UINT64_MAX, 2, &off));
+    nvn_m3_ranges_remove(&t, 1);
+
+    // More than the inherited implementation's fixed 512-entry limit.
+    for (uintptr_t i = 1; i <= 4096; i++)
+        assert(nvn_m3_ranges_add(&t, i, 0x100000000ull + i * 0x1000, 0x100));
+    for (uintptr_t i = 1; i <= 4096; i++) {
+        uint64_t base = 0x100000000ull + i * 0x1000;
+        assert(nvn_m3_ranges_find(&t, base, 0x100, &off) == i && off == 0);
+        assert(nvn_m3_ranges_find(&t, base + 0xff, 1, &off) == i && off == 0xff);
+        assert(!nvn_m3_ranges_find(&t, base + 0xff, 2, &off));
+        assert(!nvn_m3_ranges_find(&t, base + 0x100, 1, &off));
+        assert(!nvn_m3_ranges_find(&t, base, 0, &off));
+    }
+    // Updating an existing object replaces its mapping without duplicates.
+    assert(nvn_m3_ranges_add(&t, 1, 0x8000, 0x20));
+    assert(t.n == 4096);
+    assert(!nvn_m3_ranges_find(&t, 0x100001000ull, 1, &off));
+    assert(nvn_m3_ranges_find(&t, 0x801f, 1, &off) == 1);
+    assert(nvn_m3_ranges_find(&t, 0x101000000ull, 1, &off) == 4096);
+    nvn_m3_ranges_remove(&t, 1); // swap removal invalidates the cached index
+    assert(nvn_m3_ranges_find(&t, 0x101000000ull, 1, &off) == 4096);
+    nvn_m3_ranges_destroy(&t);
+
+    // Mutations and queries checked against an independent fixed-slot model.
+    unsigned char live[256] = {0}; size_t count = 0;
+    for (int step = 0; step < 100000; step++) {
+        unsigned slot = random32() % 256, action = random32() % 3;
+        uintptr_t obj = slot + 1; uint64_t base = 0x10000ull + slot * 0x1000;
+        if (action == 0) {
+            assert(nvn_m3_ranges_add(&t, obj, base, 256));
+            if (!live[slot]) { live[slot] = 1; count++; }
+        } else if (action == 1) {
+            nvn_m3_ranges_remove(&t, obj);
+            if (live[slot]) { live[slot] = 0; count--; }
+        } else {
+            uint64_t delta = random32() % 300, size = random32() % 300;
+            int valid = live[slot] && size && delta < 256 && size <= 256 - delta;
+            uintptr_t got = nvn_m3_ranges_find(&t, base + delta, size, &off);
+            assert(got == (valid ? obj : 0));
+            assert(off == (valid ? delta : 0));
+        }
+        assert(t.n == count);
+    }
+    nvn_m3_ranges_destroy(&t);
+    assert(!t.v && !t.n && !t.capacity);
+    puts("m3 ranges: boundaries, 4096 buffers, duplicate/remove, 100000 model operations passed");
+    return 0;
+}
diff --git a/dm/ios/tests/test_ios18_port.py b/dm/ios/tests/test_ios18_port.py
new file mode 100644
index 0000000..cf3b8e5
--- /dev/null
+++ b/dm/ios/tests/test_ios18_port.py
@@ -0,0 +1,110 @@
+"""No game assets required. These checks do not compile or execute Metal."""
+import importlib.util
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[3]
+IOS = ROOT / 'dm/ios'
+SPEC = IOS / 'project.yml'
+spec = importlib.util.spec_from_file_location('project_m3', IOS / 'tools/project_m3.py')
+project = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(project)
+
+
+class ProjectTests(unittest.TestCase):
+    def test_legacy_variant(self):
+        original = SPEC.read_text()
+        result = project.transform(original)
+        self.assertIn('iOS: "18.0"', result)
+        self.assertIn('-mcpu=apple-a14 -DDM_NVN_M3=1', result)
+        self.assertNotIn('apple-a18', result)
+        self.assertEqual(original, SPEC.read_text())
+
+    def test_changed_or_duplicate_settings_rejected(self):
+        source = SPEC.read_text()
+        for old in ['    iOS: "26.0"', 'OTHER_CFLAGS: $(inherited) -mcpu=apple-a18']:
+            for changed in [source.replace(old, old + '\n' + old), source.replace(old, 'missing')]:
+                with self.assertRaises(ValueError):
+                    project.transform(changed)
+
+    def test_cli_rejects_overwriting_source(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path = Path(folder) / 'project.yml'
+            original = SPEC.read_bytes(); path.write_bytes(original)
+            run = subprocess.run([sys.executable, str(IOS / 'tools/project_m3.py'), str(path), str(path)], capture_output=True)
+            self.assertNotEqual(run.returncode, 0)
+            self.assertEqual(original, path.read_bytes())
+
+    def test_bad_input_does_not_change_destination(self):
+        with tempfile.TemporaryDirectory() as folder:
+            source, target = Path(folder) / 'bad.yml', Path(folder) / 'out.yml'
+            source.write_text('unrecognized project'); target.write_text('keep this')
+            run = subprocess.run([sys.executable, str(IOS / 'tools/project_m3.py'), str(source), str(target)], capture_output=True)
+            self.assertNotEqual(run.returncode, 0)
+            self.assertEqual('keep this', target.read_text())
+
+
+def flatten(path, stack=()):
+    """Include project files, omitting unavailable Apple/system headers.
+
+    This is a preprocessor check only: no platform API types are supplied or
+    validated. Preserve repeated .inc inclusions and real preprocessor guards.
+    """
+    path = path.resolve()
+    if path in stack:
+        return ''
+    def replace(match):
+        relative = match.group(1)
+        candidate = path.parent / relative if relative else None
+        if candidate and candidate.is_file() and ROOT in candidate.resolve().parents:
+            return flatten(candidate, (*stack, path))
+        return '\n'
+    return re.sub(r'^\s*#\s*(?:include|import)\s+(?:"([^"]+)"|<[^>]+>)[^\n]*', replace, path.read_text(), flags=re.M)
+
+
+@unittest.skipUnless(shutil.which('cc'), 'C preprocessor unavailable')
+class BranchTests(unittest.TestCase):
+    def test_no_metal4_api_in_legacy_branch(self):
+        files = ['dm/gfx/nvn/nvn_mtl.m', 'dm/gfx/tex/nvn_deswizzle_gpu.m']
+        # Test real-device iOS, simulator, and macOS preprocessor paths.
+        for ios, simulator in [(1, 0), (1, 1), (0, 0)]:
+            for name in files:
+                with self.subTest(ios=ios, simulator=simulator, file=name):
+                    completed = subprocess.run(['cc', '-E', '-P', '-x', 'c', '-DDM_NVN_M3=1',
+                        f'-DTARGET_OS_IPHONE={ios}', f'-DTARGET_OS_OSX={1-ios}',
+                        f'-DTARGET_OS_SIMULATOR={simulator}', '-'],
+                        input=flatten(ROOT / name), text=True, capture_output=True)
+                    self.assertEqual(completed.returncode, 0, completed.stderr)
+                    result = completed.stdout
+                    # Strip strings so diagnostic messages are not API identifiers.
+                    code = re.sub(r'"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'', '', result)
+                    self.assertFalse(re.findall(r'\bMTL4\w*\b', code))
+                    self.assertFalse(re.findall(r'\b(?:g_q4|g_alloc4|g_up_alloc4|g_present_alloc4|g_vt|g_ft|g_ct|g_up_ct)\b', code))
+                    # Catch conditional edits leaving unmatched scopes. This is
+                    # deliberately weaker than Objective-C syntax/type checking.
+                    stack = []
+                    for char in code:
+                        if char in '({[': stack.append(char)
+                        elif char in ')}]':
+                            self.assertTrue(stack, 'extra closing delimiter')
+                            self.assertEqual('({['[')}]'.index(char)], stack.pop())
+                    self.assertFalse(stack, 'unclosed delimiter')
+
+
+@unittest.skipUnless(shutil.which('cc'), 'C compiler unavailable')
+class RangeTests(unittest.TestCase):
+    def test_address_lookup_model(self):
+        with tempfile.TemporaryDirectory() as folder:
+            binary = Path(folder) / 'ranges'
+            subprocess.run(['cc', '-std=c11', '-O1', '-g', '-Wall', '-Wextra', '-Werror',
+                '-fsanitize=address,undefined', str(ROOT / 'dm/gfx/tests/t_m3_ranges.c'), '-o', str(binary)], check=True)
+            subprocess.run([str(binary)], check=True)
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
